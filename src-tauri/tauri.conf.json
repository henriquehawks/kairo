{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Kairo",
    "version":  "0.3.5",
    "identifier":  "com.kairo.desktop",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5420",
                  "beforeDevCommand":  "",
                  "beforeBuildCommand":  "pnpm build \u0026\u0026 pnpm ponte:build"
              },
    "app":  {
                "windows":  [

                            ],
                "withGlobalTauri":  false,
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; connect-src \u0027self\u0027 ipc: http://ipc.localhost http://127.0.0.1:47831; img-src \u0027self\u0027 data: blob: https:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; font-src \u0027self\u0027 data:; script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027; media-src \u0027self\u0027 data: blob:; frame-src \u0027self\u0027 blob:; worker-src \u0027self\u0027 blob:; object-src \u0027none\u0027; base-uri \u0027none\u0027; form-action \u0027none\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis",
                                   "msi"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "resources":  {
                                     "recursos/node.exe":  "recursos/node.exe",
                                     "recursos/ponte.mjs":  "recursos/ponte.mjs"
                                 },
                   "publisher":  "henriquehawks",
                   "shortDescription":  "Kairo, seu sistema de vida para Windows",
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "languages":  [
                                                                  "PortugueseBR"
                                                              ],
                                                "displayLanguageSelector":  false,
                                                "installerHooks":  "windows/ganchos.nsh"
                                            },
                                   "wix":  {
                                               "language":  "pt-BR",
                                               "upgradeCode":  "4c8e023d-542b-4775-bb95-a11d5051082d"
                                           }
                               },
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3QzU1QzM1MzUzOTkyQTgKUldTb2tqazFOVnpGOXlaVHlJOTdIYk1kNTZsV3o4SVNvZXVQeStwZW9CYXdFb3EydEkwRm5xbFEK",
                                    "endpoints":  [
